# Caddy Reverse Proxy with Cloudflare SSL

# Redirect all HTTP traffic (port 80) to HTTPS on the official domain
:80 {
    redir https://noteusv.tech{uri} permanent
}

:8080 {
    # Redirect if the host header is not the official domain (e.g., direct IP access)
    @notDomain {
        not header_regexp Host ^(noteusv\.tech|www\.noteusv\.tech|localhost|127\.0\.0\.1)(:\d+)?$
    }
    redir @notDomain https://noteusv.tech{uri} permanent

    # TLS configuration using the Cloudflare Origin Certificate
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    # Reverse proxy to the Next.js app.
    # usv-proxy shares the network namespace of usv-vpn (sidecar pattern),
    # so port 3000 is reachable via the usv-vpn container name.
    reverse_proxy usv-vpn:3000

    # Modern logging (optional)
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
