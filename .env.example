# USV Student Portal - VPN & Proxy Credentials
# Rename this file to '.env' on your VPS and fill in your credentials

# USV Student VPN Credentials (e.g., student.name / password)
VPN_USER=PRENUME.NUME
VPN_PASS=PAROLA_TA_AICI

# The port you want to expose the proxy on the VPS (default: 3001)
HOST_PORT=3001

# Session Cookie Encryption Key (AES-256-GCM)
# Used to encrypt the PS_PROXY_SESSION browser cookie.
# Change this value to instantly invalidate all active sessions (key rotation).
# Generate a strong random passphrase — do NOT use the example value in production.
COOKIE_ENCRYPTION_KEY=CHEIA_TA_SECRETA_AICI

# ──────────────────────────────────────────────────
# Monitoring Stack (Prometheus + Grafana)
# ──────────────────────────────────────────────────

# Grafana admin credentials (used to log in to the Grafana web UI)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_ADMIN_PASSWORD_HERE

# Caddy HTTP Basic Auth for stats.noteusv.tech
# The username shown in the browser's native login prompt
GRAFANA_BASIC_AUTH_USER=stats
# Bcrypt hash of the browser login password — generate it on the VPS with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "YourPassword"
# IMPORTANT: You must escape all '$' characters as '$$' (e.g. $$2a$$14$$...)
# to prevent Docker Compose from interpreting them as environment variables.
# Example output (do NOT use this example!): $$2a$$14$$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5NeB1v6XSJYhKmwKGe
GRAFANA_BASIC_AUTH_HASH=YOUR_BCRYPT_HASH_HERE

# Secure scrape token for Next.js app metrics
METRICS_TOKEN=YOUR_SECURE_METRICS_TOKEN_HERE

# Caddy HTTP Basic Auth for status.noteusv.tech
KUMA_BASIC_AUTH_USER=status
# Bcrypt hash of the browser login password for status page admin paths.
# Escape all '$' characters as '$$' (e.g. $$2a$$14$$...).
KUMA_BASIC_AUTH_HASH=YOUR_BCRYPT_HASH_HERE


